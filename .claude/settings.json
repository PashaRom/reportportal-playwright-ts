{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tsc-check.js",
            "timeout": 60,
            "statusMessage": "Checking TypeScript..."
          }
        ]
      }
    ]
  }
}
